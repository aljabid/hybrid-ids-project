legacy/models/**/saved/
legacy/models/**/logs/

# === Build artifacts (regenerate from source folders rather than tracking the zip itself) ===
*.zip

# === Environment / secrets (defensive; none currently present) ===
.env
.env.*
*.pem
**/credentials.json
